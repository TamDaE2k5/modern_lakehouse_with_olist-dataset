MINIO_UPLOAD_PASSWORD=
MINIO_PROCESSING_USER=
MINIO_PROCESSING_PASSWORD=
MINIO_QUERY_USER=
MINIO_QUERY_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
ICEBERG_DB_PASSWORD=
AIRFLOW_DB_PASSWORD=
SUPERSET_DB_PASSWORD=
AIRFLOW_ADMIN_PASSWORD=
SUPERSET_ADMIN_PASSWORD=
SUPERSET_SECRET_KEY=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
PIPELINE_METRICS_POLL_INTERVAL_SECONDS=30
PIPELINE_METRICS_TRINO_TIMEOUT_SECONDS=10
PIPELINE_METRICS_CONTROL_SCHEMA=control
PIPELINE_METRICS_QUALITY_SCHEMA=quality
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
ICEBERG_WAREHOUSE=s3://lakehouse/
SPARK_MASTER_URL=spark://spark-master:7077

# --- CẢNH BÁO SỰ CỐ QUA EMAIL (GMAIL SMTP / ENTERPRISE SMTP) ------------------------
# Hướng dẫn dùng Gmail thật:
#   1. Bật xác thực 2 bước: https://myaccount.google.com/signinoptions/two-step-verification
#   2. Tạo Mật khẩu ứng dụng 16 ký tự: https://myaccount.google.com/apppasswords
#   3. Điền tài khoản và mật khẩu ứng dụng vào ALERT_SMTP_USER và ALERT_SMTP_PASSWORD.
ALERT_EMAIL_ENABLED=true
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=your_email@gmail.com
ALERT_SMTP_PASSWORD=
ALERT_SMTP_STARTTLS=true
ALERT_SMTP_SSL=false
ALERT_FROM_EMAIL=your_email@gmail.com
ALERT_ADMIN_EMAIL=your_email@gmail.com

# Giả lập MailHog nội bộ (chỉ dùng khi test offline không có mạng):
# ALERT_SMTP_HOST=mailhog
# ALERT_SMTP_PORT=1025
# ALERT_SMTP_STARTTLS=false
MAILHOG_UI_PORT=8025
